PORT=3020
DATABASE_URL=file:./prisma/dev.db

# CORS: URL del frontend (Vercel o túnel). En dev también se permiten localhost y *.trycloudflare.com
# FRONTEND_URL=https://jeniffer-facturas.vercel.app
# CORS_ORIGINS=https://otro-dominio.com,https://xxx.trycloudflare.com
# ALLOW_CLOUDFLARE_TUNNEL=1

# Opcional: consumir BCV desde API Costos en ejecución (si no, usa el mismo módulo BCV local)
# COSTOS_API_URL=http://127.0.0.1:3011
# COSTOS_API_EMAIL=admin@albatros.com
# COSTOS_API_PASSWORD=Albatros2026!
# O token JWT fijo:
# COSTOS_API_TOKEN=
